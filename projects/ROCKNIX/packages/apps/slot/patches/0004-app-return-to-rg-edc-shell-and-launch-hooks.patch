+//! RG EDC: hooks that let the RG EDC shell launch slot onto a given shelf or
+//! game and get control back.
+//!
+//! - SLOT_SHELF=gb|gbc|gba|recents|favorites opens slot on that shelf.
+//! - SLOT_INSERT=<rom path or file name> selects that game and inserts it.
+//! - SLOT_BACK_EXITS=1 makes B on the shelf quit back to the shell.
+use std::path::Path;
+
+pub fn shelf() -> Option<String> {
+    let v = std::env::var("SLOT_SHELF").ok()?;
+    let v = v.trim().to_ascii_lowercase();
+    (!v.is_empty()).then_some(v)
+}
+
+pub fn insert_stem() -> Option<String> {
+    let v = std::env::var("SLOT_INSERT").ok()?;
+    let stem = Path::new(v.trim()).file_stem()?.to_string_lossy().into_owned();
+    (!stem.is_empty()).then_some(stem)
+}
+
+pub fn back_exits() -> bool {
+    std::env::var_os("SLOT_BACK_EXITS").is_some_and(|v| v != "0")
+}
