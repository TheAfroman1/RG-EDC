+//! RG EDC: SLOT_PERF=1 prints a once-per-second line with the render rate,
+//! the emulated frame rate and the audio stream's state, to diagnose pacing
+//! on devices where slot runs through PipeWire.
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+pub static EMU_FRAMES: AtomicU64 = AtomicU64::new(0);
+pub static RENDERED: AtomicU64 = AtomicU64::new(0);
+pub static RENDER_US: AtomicU64 = AtomicU64::new(0);
+pub static AUDIO_CALLBACKS: AtomicU64 = AtomicU64::new(0);
+pub static AUDIO_FRAMES: AtomicU64 = AtomicU64::new(0);
+pub static AUDIO_QUEUED: AtomicU64 = AtomicU64::new(0);
+pub static AUDIO_CAPACITY: AtomicU64 = AtomicU64::new(0);
+pub static AUDIO_UNDERRUNS: AtomicU64 = AtomicU64::new(0);
+
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("SLOT_PERF").is_some_and(|v| v != "0"))
+}
+
+pub struct Reporter {
+    since: Instant,
+    last: [u64; 5],
+}
+
+impl Default for Reporter {
+    fn default() -> Self {
+        Reporter { since: Instant::now(), last: [0; 5] }
+    }
+}
+
+impl Reporter {
+    pub fn tick(&mut self) {
+        if !enabled() {
+            return;
+        }
+        let secs = self.since.elapsed().as_secs_f64();
+        if secs < 1.0 {
+            return;
+        }
+        let now = [
+            EMU_FRAMES.load(Ordering::Relaxed),
+            RENDERED.load(Ordering::Relaxed),
+            RENDER_US.load(Ordering::Relaxed),
+            AUDIO_FRAMES.load(Ordering::Relaxed),
+            AUDIO_UNDERRUNS.load(Ordering::Relaxed),
+        ];
+        let d = |i: usize| now[i].saturating_sub(self.last[i]);
+        let rendered = d(1).max(1);
+        eprintln!(
+            "slot: perf: emu {:.1} fps, render {:.1} fps, frame {:.1} ms, audio {:.0} Hz consumed, queued {}/{} frames, underrun {} frames, callbacks {}",
+            d(0) as f64 / secs,
+            d(1) as f64 / secs,
+            d(2) as f64 / rendered as f64 / 1000.0,
+            d(3) as f64 / secs,
+            AUDIO_QUEUED.load(Ordering::Relaxed),
+            AUDIO_CAPACITY.load(Ordering::Relaxed),
+            d(4),
+            AUDIO_CALLBACKS.swap(0, Ordering::Relaxed),
+        );
+        self.last = now;
+        self.since = Instant::now();
+    }
+}
