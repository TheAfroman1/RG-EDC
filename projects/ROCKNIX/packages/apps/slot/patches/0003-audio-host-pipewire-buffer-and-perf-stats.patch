-const PERIOD_FRAMES: u32 = 512;
+// RG EDC: cpal's ALSA backend uses BufferSize::Fixed(n) as the whole ALSA
+// buffer (period n/4). Upstream's 512 frames is less than one PipeWire graph
+// cycle on devices whose quantum is pinned (1280 frames on the RG Rotate), so
+// pipewire-alsa starved every cycle and, because the emulator is paced by
+// this stream, games ran slow with stretched sound. Default to 2560 frames
+// (two 1280 cycles); SLOT_AUDIO_BUFFER=<frames> overrides it.
+const PERIOD_FRAMES: u32 = 2560;
+
+fn buffer_frames() -> u32 {
+    std::env::var("SLOT_AUDIO_BUFFER")
+        .ok()
+        .and_then(|v| v.trim().parse().ok())
+        .filter(|&n: &u32| n >= 64)
+        .unwrap_or(PERIOD_FRAMES)
+}
 
