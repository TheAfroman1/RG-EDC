# Battery, for Gadgetbridge's status line

def battery():
    base = "/sys/class/power_supply/battery"
    try:
        with open(base + "/capacity") as f:
            cap = int(f.read().strip())
        with open(base + "/status") as f:
            chg = f.read().strip() == "Charging"
        return cap, chg
    except (OSError, ValueError):
        return None, False

