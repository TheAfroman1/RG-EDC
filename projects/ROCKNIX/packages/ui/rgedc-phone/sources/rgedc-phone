def setup_logging():
    fmt = logging.Formatter("%(asctime)s %(levelname)s %(message)s", "%Y-%m-%d %H:%M:%S")
    root = logging.getLogger()
    root.setLevel(logging.DEBUG if os.environ.get("RGEDC_PHONE_DEBUG") else logging.INFO)
    h = logging.StreamHandler(sys.stderr)
    h.setFormatter(fmt)
    root.addHandler(h)
    try:
        fh = logging.FileHandler(LOG_FILE)
        fh.setFormatter(fmt)
        root.addHandler(fh)
    except OSError:
        pass


async def main():
    setup_logging()
    log.info("rgedc-phone %s starting", VERSION)
    loop = asyncio.get_running_loop()
    store = Store(os.path.join(CACHE_DIR, "notifications.json"))
    link = Link(store, loop)
    hub = Hub(store, link, loop)
    await hub.start()
    await link.start()
    stop = loop.create_future()
    for s in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(s, lambda: stop.done() or stop.set_result(None))
    await stop
    log.info("stopping")
    try:
        if link.adv_registered:
            await link.call(link.adapter, "org.bluez.LEAdvertisingManager1",
                            "UnregisterAdvertisement", "o", link.ADV_PATH, timeout=2000)
    except Exception:
        pass
    try:
        os.unlink(SOCK_PATH)
    except OSError:
        pass


if __name__ == "__main__":
    asyncio.run(main())
