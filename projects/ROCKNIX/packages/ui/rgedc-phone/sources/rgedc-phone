CMD_NOTIF_ATTRS, CMD_APP_ATTRS, CMD_ACTION = 0, 1, 2
A_APPID, A_TITLE, A_SUBTITLE, A_MESSAGE, A_MSGSIZE, A_DATE, A_POS, A_NEG = range(8)
NOTIF_ATTRS = [(A_APPID, None), (A_TITLE, 64), (A_SUBTITLE, 64), (A_MESSAGE, 400),
               (A_DATE, None), (A_POS, None), (A_NEG, None)]
ACTION_POSITIVE, ACTION_NEGATIVE = 0, 1


def ancs_parse_ns(data):
    """Notification Source packet -> dict, or None if malformed."""
    data = bytes(data)
    if len(data) < 8:
        return None
    ev, flags, cat, count, uid = struct.unpack("<BBBBI", data[:8])
    return {"event": ev, "flags": flags, "category": cat, "count": count, "uid": uid}


def ancs_cmd_notif_attrs(uid, attrs=NOTIF_ATTRS):
    out = bytearray(struct.pack("<BI", CMD_NOTIF_ATTRS, uid))
    for aid, maxlen in attrs:
        out.append(aid)
        if maxlen is not None:
            out += struct.pack("<H", maxlen)
    return bytes(out)


def ancs_cmd_app_attrs(app_id):
    return bytes([CMD_APP_ATTRS]) + app_id.encode() + b"\0" + bytes([0])


def ancs_cmd_action(uid, positive):
    return struct.pack("<BIB", CMD_ACTION, uid, ACTION_POSITIVE if positive else ACTION_NEGATIVE)


class AncsResponse:
    """Reassembles one Data Source response, which can span several packets."""

    def __init__(self, cmd, attr_ids, app_id=None):
        self.cmd = cmd
        self.attr_ids = list(attr_ids)
        self.app_id = app_id
        self.buf = b""
        self.uid = None
        self.attrs = {}

    def feed(self, data):
        """Adds a packet; returns True once every attribute has arrived."""
        self.buf += bytes(data)
        b = self.buf
        if not b:
            return False
        if b[0] != self.cmd:
            raise ValueError("unexpected ANCS command id %d" % b[0])
        if self.cmd == CMD_NOTIF_ATTRS:
            if len(b) < 5:
                return False
            self.uid = struct.unpack("<I", b[1:5])[0]
            pos = 5
        else:
            end = b.find(b"\0", 1)
            if end < 0:
                return False
            self.app_id = b[1:end].decode("utf-8", "replace")
            pos = end + 1
        attrs = {}
        for _ in self.attr_ids:
            if len(b) < pos + 3:
                return False
            aid, ln = struct.unpack("<BH", b[pos:pos + 3])
            if len(b) < pos + 3 + ln:
                return False
            attrs[aid] = b[pos + 3:pos + 3 + ln].decode("utf-8", "replace")
            pos += 3 + ln
        self.attrs = attrs
        return True


def ancs_date(s):
    """'yyyyMMddTHHmmSS' (phone local time) -> epoch seconds, or None."""
    try:
        return time.mktime(time.strptime(s, "%Y%m%dT%H%M%S"))
    except (ValueError, OverflowError):
        return None


def cts_to_utc(current, localinfo=None):
    """Current Time (0x2A2B) and Local Time Information (0x2A0F) -> UTC epoch."""
    current = bytes(current)
    if len(current) < 7:
        return None
    year, month, day, hh, mm, ss = struct.unpack("<HBBBBB", current[:7])
    if year < 2000 or not (1 <= month <= 12 and 1 <= day <= 31):
        return None
    local = calendar.timegm((year, month, day, hh, mm, ss, 0, 0, 0))
    offset = 0
    if localinfo is not None and len(bytes(localinfo)) >= 2:
        tz, dst = struct.unpack("<bB", bytes(localinfo)[:2])
        if tz != -128:
            offset += tz * 15 * 60
        if dst != 255:
            offset += {0: 0, 2: 1800, 4: 3600, 8: 7200}.get(dst, 0)
    return local - offset

# ---------------------------------------------------------------------------
# Gadgetbridge / Bangle.js protocol (pure)

class EspruinoJSONError(ValueError):
    pass


def parse_espruino_json(s):
    """Parses the JSON-ish text Gadgetbridge sends to Bangle.js: JSON plus
    \\xNN and \\N escapes, \\v, and atob("base64") strings."""
    import base64
    pos = 0
    n = len(s)

    def ws():
        nonlocal pos
        while pos < n and s[pos] in " \t\r\n":
            pos += 1

    def string():
        nonlocal pos
        q = s[pos]
        pos += 1
        out = []
        while True:
            if pos >= n:
                raise EspruinoJSONError("unterminated string")
            c = s[pos]
            if c == q:
                pos += 1
                return "".join(out)
            if c != "\\":
                out.append(c)
                pos += 1
                continue
            pos += 1
            if pos >= n:
                raise EspruinoJSONError("bad escape")
            e = s[pos]
            pos += 1
            simple = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f", "v": "\v",
                      '"': '"', "'": "'", "\\": "\\", "/": "/"}
            if e in simple:
                out.append(simple[e])
            elif e == "x":
                out.append(chr(int(s[pos:pos + 2], 16)))
                pos += 2
            elif e == "u":
                out.append(chr(int(s[pos:pos + 4], 16)))
                pos += 4
            elif e in "01234567":
                # Octal, one to three digits (\0, \20 = DLE, \x0N is hex above)
                j = pos
                while j < n and j < pos + 2 and s[j] in "01234567":
                    j += 1
                out.append(chr(int(e + s[pos:j], 8)))
                pos = j
            else:
                out.append(e)

    def value():
        nonlocal pos
        ws()
        if pos >= n:
            raise EspruinoJSONError("unexpected end")
        c = s[pos]
        if c == "{":
            pos += 1
            obj = {}
            ws()
            if pos < n and s[pos] == "}":
                pos += 1
                return obj
            while True:
                ws()
                if s[pos] in "\"'":
                    k = string()
                else:
                    m = re.compile(r"[A-Za-z_$][\w$]*").match(s, pos)
                    if not m:
                        raise EspruinoJSONError("bad key at %d" % pos)
                    k = m.group(0)
                    pos = m.end()
                ws()
                if pos >= n or s[pos] != ":":
                    raise EspruinoJSONError("expected : at %d" % pos)
                pos += 1
                obj[k] = value()
                ws()
                if pos < n and s[pos] == ",":
                    pos += 1
                    continue
                if pos < n and s[pos] == "}":
                    pos += 1
                    return obj
                raise EspruinoJSONError("expected , or } at %d" % pos)
        if c == "[":
            pos += 1
            arr = []
            ws()
            if pos < n and s[pos] == "]":
                pos += 1
                return arr
            while True:
                arr.append(value())
                ws()
                if pos < n and s[pos] == ",":
                    pos += 1
                    continue
                if pos < n and s[pos] == "]":
                    pos += 1
                    return arr
                raise EspruinoJSONError("expected , or ] at %d" % pos)
        if c in "\"'":
            return string()
        if s.startswith("atob(", pos):
            pos += 5
            ws()
            enc = string()
            ws()
            if pos >= n or s[pos] != ")":
                raise EspruinoJSONError("bad atob")
            pos += 1
            return base64.b64decode(enc + "=" * (-len(enc) % 4)).decode("latin-1")
        for word, val in (("true", True), ("false", False), ("null", None), ("undefined", None)):
            if s.startswith(word, pos):
                pos += len(word)
                return val
        m = re.compile(r"-?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?").match(s, pos)
        if m:
            pos = m.end()
            t = m.group(0)
            return float(t) if any(ch in t for ch in ".eE") else int(t)
        raise EspruinoJSONError("unexpected %r at %d" % (c, pos))

    v = value()
    ws()
    if pos != n:
        raise EspruinoJSONError("trailing data at %d" % pos)
    return v


def latin1_to_text(s):
    """Gadgetbridge sends Java chars as single bytes (<=255) or \\uXXXX; UTF-16
    surrogate pairs come through as two \\u escapes. Join them back up."""
    try:
        return s.encode("utf-16", "surrogatepass").decode("utf-16")
    except UnicodeError:
        return s


def gb_parse_line(line):
    """One line from Gadgetbridge -> list of (kind, payload)."""
    out = []
    line = line.strip().lstrip("\x10\x03").strip()
    if not line:
        return out
    for part in re.split(r";\s*(?=[A-Za-z\x10])", line):
        part = part.strip().lstrip("\x10").strip()
        if part.startswith("GB(") and part.endswith(")"):
            try:
                obj = parse_espruino_json(part[3:-1])
            except (EspruinoJSONError, ValueError, IndexError) as e:
                log.warning("bad GB() payload: %s (%s)", part[:120], e)
                continue
            if isinstance(obj, dict):
                out.append(("gb", obj))
            continue
        m = re.match(r"setTime\((\d+(?:\.\d+)?)\)", part)
        if m:
            out.append(("time", float(m.group(1))))
            continue
        m = re.match(r"E\.setTimeZone\((-?\d+(?:\.\d+)?)\)", part)
        if m:
            out.append(("tz", float(m.group(1))))
            continue
    return out


def gb_line(obj):
    """Our reply to Gadgetbridge: one JSON line. It drops the char before \\n."""
    return (json.dumps(obj, separators=(",", ":")) + "\r\n").encode("utf-8")

# ---------------------------------------------------------------------------
# Notification store

class Store:
    def __init__(self, path):
        self.path = path
        self.items = []
        self.listeners = []
        self.load()

    def load(self):
        try:
            with open(self.path) as f:
                data = json.load(f)
            self.items = [i for i in data.get("items", []) if isinstance(i, dict) and "id" in i]
        except (OSError, ValueError):
            self.items = []

    def save(self):
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            tmp = self.path + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"items": self.items}, f)
            os.replace(tmp, self.path)
        except OSError as e:
            log.warning("could not save notifications: %s", e)

    def changed(self, posted=None):
        self.save()
        for fn in self.listeners:
            fn(posted)

    def get(self, nid):
        for i in self.items:
            if i["id"] == nid:
                return i
        return None

    def put(self, item, announce):
        """Adds or replaces (same id). announce: tell the shell to pop a banner."""
        old = self.get(item["id"])
        if old is not None:
            item.setdefault("read", old.get("read", False))
            self.items.remove(old)
        item.setdefault("read", False)
        self.items.append(item)
        self.items.sort(key=lambda i: i.get("time", 0), reverse=True)
        del self.items[MAX_ITEMS:]
        self.changed(item if announce else None)

    def remove(self, nid):
        i = self.get(nid)
        if i is not None:
            self.items.remove(i)
            self.changed()

    def remove_where(self, pred):
        before = len(self.items)
        self.items = [i for i in self.items if not pred(i)]
        if len(self.items) != before:
            self.changed()

    def mark_read(self):
        if any(not i.get("read") for i in self.items):
            for i in self.items:
                i["read"] = True
            self.changed()

# ---------------------------------------------------------------------------
# Clock

def set_clock(utc, source):
    if not SET_CLOCK or utc is None:
        return
    drift = utc - time.time()
    if abs(drift) < 2:
        return
    try:
        time.clock_settime(time.CLOCK_REALTIME, utc)
        log.info("clock set from %s (was %+.0f s off)", source, -drift)
        subprocess.run(["hwclock", "--systohc", "--utc"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        log.warning("could not set clock: %s", e)

