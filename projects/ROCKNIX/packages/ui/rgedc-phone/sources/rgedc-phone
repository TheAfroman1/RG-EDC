# The shell's socket

class Hub:
    """Unix socket for the shell. Lines of JSON.

    To the shell:
      {"t":"state","bt":bool,"adv":"" or error,"pairing":"","phone":{...},
       "known":[{name,kind,address}],"music":{...},"note":""}
      {"t":"list","items":[notification, ...]}         newest first
      {"t":"posted","item":notification}                 pop a banner
      {"t":"call","call":{name,number,pos,neg,...} or null}
    From the shell:
      {"t":"dismiss","id":..}  {"t":"action","id":..,"positive":bool}
      {"t":"clear"}  {"t":"read"}  {"t":"pair","kind":"ios"|"android"|""}
      {"t":"forget"}  {"t":"music","cmd":"next"}  {"t":"reply","id":..,"text":..}
    """

    def __init__(self, store, link, loop):
        self.store = store
        self.link = link
        self.loop = loop
        self.clients = set()
        self.note = ""
        store.listeners.append(self.on_store)
        link.on_state = self.on_state
        link.on_call = self.on_call
        link.call_state = None

    async def start(self):
        try:
            os.unlink(SOCK_PATH)
        except FileNotFoundError:
            pass
        self.server = await asyncio.start_unix_server(self.client, path=SOCK_PATH)
        os.chmod(SOCK_PATH, 0o666)
        log.info("listening on %s", SOCK_PATH)

    def state(self):
        link = self.link
        return {"t": "state", "bt": bool(link.adapter and link.adapter_powered),
                "adv": link.adv_error, "advertising": link.adv_registered,
                "pairing": link.pairing, "phone": link.phone_info(),
                "known": link.known, "music": link.phone_music, "note": self.note,
                "canned": link.canned}

    def send_all(self, obj):
        data = (json.dumps(obj, ensure_ascii=False) + "\n").encode()
        for w in list(self.clients):
            try:
                w.write(data)
            except (ConnectionError, RuntimeError):
                self.clients.discard(w)

    def on_state(self, note=None):
        if note is not None:
            self.note = note
        elif self.link.phone_connected():
            self.note = ""
        self.send_all(self.state())

    def on_store(self, posted):
        self.send_all({"t": "list", "items": self.store.items})
        if posted:
            self.send_all({"t": "posted", "item": posted})

    def on_call(self, call):
        self.link.call_state = call
        self.send_all({"t": "call", "call": call})

    async def client(self, reader, writer):
        self.clients.add(writer)
        try:
            for obj in (self.state(), {"t": "list", "items": self.store.items},
                        {"t": "call", "call": self.link.call_state}):
                writer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode())
            while True:
                line = await reader.readline()
                if not line:
                    break
                try:
                    cmd = json.loads(line)
                except ValueError:
                    continue
                if isinstance(cmd, dict):
                    await self.command(cmd)
        except (ConnectionError, asyncio.IncompleteReadError):
            pass
        finally:
            self.clients.discard(writer)
            writer.close()

    async def command(self, c):
        t = c.get("t")
        link = self.link
        log.debug("shell: %s", c)
        if t == "dismiss":
            link.dismiss(str(c.get("id", "")))
        elif t == "action":
            link.action(str(c.get("id", "")), bool(c.get("positive")))
        elif t == "clear":
            for i in list(self.store.items):
                link.dismiss(i["id"])
        elif t == "read":
            self.store.mark_read()
        elif t == "pair":
            link.set_pairing(str(c.get("kind", "")))
        elif t == "forget":
            await link.forget()
        elif t == "reply":
            ok = link.reply(str(c.get("id", "")), str(c.get("text", ""))[:500])
            self.send_all({"t": "replied", "id": c.get("id"), "ok": ok})
        elif t == "music":
            link.music(str(c.get("cmd", "")))

